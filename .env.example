# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
STARLINK_ENTITY_PREFIX=sensor.starlink

# Grok (xAI) — used by the in-dashboard ops assistant
GROK_API_KEY=
# XAI_API_KEY=
# GROK_MODEL=grok-2-latest
# GROK_BASE_URL=https://api.x.ai/v1

# Auth (required in production — min 16 chars)
AUTH_SECRET=change-me-to-a-long-random-string
# ORBITDESK_DATA_DIR=/opt/orbitdesk/data

# App
POLL_INTERVAL_SECONDS=30
# FORCE_DEMO_MODE=true

# Remote sites are saved from Connections → Remote sites into the data
# directory (sites.json). Their Home Assistant tokens and WireGuard private
# keys are not stored in this file. The tunnel usually runs on the Proxmox
# host; this app only probes Home Assistant and reads `wg show` when present.
